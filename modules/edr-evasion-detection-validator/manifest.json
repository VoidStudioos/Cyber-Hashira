{
  "id": "edr-evasion-detection-validator",
  "name": "EDR Evasion & Process Injection Detection Validator",
  "description": "Validates EDR telemetry alerts against direct system call invocations, process hollowing, and unhooked NTDLL calls (Atomic-Test / Sysmon).",
  "author": "Cyber Hashira Security Team",
  "version": "1.0.0",
  "min_host_version": "0.1.0",
  "category": "Blue Team & Threat Hunting",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_arch": [
    "x86_64",
    "aarch64"
  ],
  "required_permissions": [
    "network:connect",
    "findings:write"
  ],
  "optional_permissions": [
    "evidence:write"
  ],
  "entry_point": {
    "runtime": "python",
    "executable": "worker.py",
    "default_args": []
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "simulate_vulnerabilities": {
        "type": "boolean",
        "default": true,
        "description": "Simulate findings safely without active invasive exploitation."
      }
    }
  },
  "contracts": {
    "input_schema": {
      "type": "object",
      "required": [
        "task_id",
        "target"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "scope_approved": {
          "type": "boolean"
        },
        "options": {
          "type": "object"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "required": [
        "task_id",
        "success",
        "findings"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "severity"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}