{
  "id": "dotnet-security-code-analyzer",
  "name": ".NET & C# Source Code Security Analyzer",
  "description": "Analyzes C# and .NET source files (Security Code Scan methodology) for unsafe SQL query concatenation, unvalidated open redirects, BinaryFormatter deserialization, and LDAP injection.",
  "author": "Cyber Hashira Security Team",
  "version": "1.0.0",
  "min_host_version": "0.1.0",
  "category": "Code Analysis",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_arch": [
    "x86_64",
    "aarch64"
  ],
  "required_permissions": [
    "network:connect",
    "findings:write"
  ],
  "entry_point": {
    "runtime": "python",
    "executable": "worker.py",
    "default_args": []
  },
  "config_schema": {
    "type": "object",
    "properties": {}
  },
  "contracts": {
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cwe": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "detected_at": {
                "type": "string"
              }
            },
            "required": [
              "cwe",
              "title",
              "description",
              "evidence",
              "detected_at"
            ]
          }
        }
      }
    }
  },
  "artifact": {
    "url": "",
    "sha256": "",
    "size_bytes": 0
  }
}