{
  "id": "reverse-dns-ptr-scanner",
  "name": "Bulk Reverse DNS & PTR Record Scanner",
  "description": "Executes mass asynchronous PTR record queries across IP subnets to resolve reverse DNS mappings, identifying staging servers, VPN gateways, and unlinked infrastructure.",
  "author": "Cyber Hashira Security Team",
  "version": "1.0.0",
  "min_host_version": "0.1.0",
  "category": "DNS Security",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_arch": [
    "x86_64",
    "aarch64"
  ],
  "required_permissions": [
    "network:connect",
    "findings:write"
  ],
  "entry_point": {
    "runtime": "python",
    "executable": "worker.py",
    "default_args": []
  },
  "config_schema": {
    "type": "object",
    "properties": {}
  },
  "contracts": {
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cwe": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "detected_at": {
                "type": "string"
              }
            },
            "required": [
              "cwe",
              "title",
              "description",
              "evidence",
              "detected_at"
            ]
          }
        }
      }
    }
  },
  "artifact": {
    "url": "",
    "sha256": "",
    "size_bytes": 0
  }
}