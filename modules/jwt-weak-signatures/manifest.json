{
  "id": "jwt-weak-signatures",
  "name": "Jwt Weak Signatures",
  "description": "Detects JWT tokens signed with 'none' algorithm or weak HMAC keys.",
  "author": "Cyber Hashira Security Team",
  "version": "1.0.0",
  "min_host_version": "0.1.0",
  "category": "Authentication & Token",
  "icon": "key",
  "supported_os": ["windows", "linux", "macos"],
  "supported_arch": ["x86_64", "aarch64"],
  "required_permissions": ["network:connect", "findings:write"],
  "entry_point": {
    "runtime": "python",
    "executable": "worker.py",
    "default_args": []
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "token_file": {
        "type": "string",
        "description": "Path to a file containing one JWT per line.",
        "default": "tokens.txt"
      }
    }
  },
  "contracts": {
    "input_schema": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "token_file": {"type": "string"}
          }
        }
      },
      "required": []
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cwe": {"type": "string"},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "evidence": {"type": "string"},
              "detected_at": {"type": "string"}
            },
            "required": ["cwe", "title", "description", "evidence", "detected_at"]
          }
        }
      }
    }
  },
  "artifact": {"url": "", "sha256": "", "size_bytes": 0}
}