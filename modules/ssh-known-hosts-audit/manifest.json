{
  "id": "ssh-known-hosts-audit",
  "name": "SSH Known Hosts Audit",
  "description": "Audits SSH known_hosts and authorized_keys for weak RSA keys (<2048 bits) and insecure algorithms.",
  "author": "Cyber Hashira Security Team",
  "version": "1.0.0",
  "min_host_version": "0.1.0",
  "category": "Infrastructure & Access",
  "icon": "shield",
  "supported_os": ["windows", "linux", "macos"],
  "supported_arch": ["x86_64", "aarch64"],
  "required_permissions": ["network:connect", "findings:write"],
  "entry_point": {
    "runtime": "python",
    "executable": "worker.py",
    "default_args": []
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "items": {"type": "string"},
        "description": "List of SSH known_hosts or authorized_keys files to audit.",
        "default": []
      }
    }
  },
  "contracts": {
    "input_schema": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "properties": {
            "paths": {"type": "array", "items": {"type": "string"}}
          }
        }
      },
      "required": []
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cwe": {"type": "string"},
              "title": {"type": "string"},
              "description": {"type": "string"},
              "evidence": {"type": "string"},
              "detected_at": {"type": "string"}
            },
            "required": ["cwe", "title", "description", "evidence", "detected_at"]
          }
        }
      }
    }
  },
  "artifact": {"url": "", "sha256": "", "size_bytes": 0}
}
