{
  "id": "oauth-redirect-uri-validator",
  "name": "OAuth 2.0 Strict Redirect URI & Wildcard Auditor",
  "description": "Validates OAuth 2.0 authorization server configurations for strict redirect_uri matching, preventing path traversal and wildcard domain matching (RFC 6749 Section 10.6).",
  "author": "Cyber Hashira Security Team",
  "version": "1.0.0",
  "min_host_version": "0.1.0",
  "category": "Authentication & Token",
  "icon": "key",
  "banner_url": "",
  "supported_os": [
    "windows",
    "linux",
    "macos"
  ],
  "supported_arch": [
    "x86_64",
    "aarch64"
  ],
  "required_dependencies": {},
  "optional_dependencies": {},
  "required_permissions": [
    "network:connect",
    "findings:write"
  ],
  "entry_point": {
    "runtime": "python",
    "executable": "worker.py",
    "default_args": []
  },
  "config_schema": {
    "type": "object",
    "properties": {}
  },
  "contracts": {
    "input_schema": {
      "type": "object",
      "properties": {},
      "required": []
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cwe": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "detected_at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}